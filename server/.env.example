# Copy to .env and fill in. The API reads these at boot (validated with Zod).

# Server
PORT=4000
NODE_ENV=development

# MongoDB Atlas connection string (Database > Connect > Drivers).
# e.g. mongodb+srv://USER:PASS@cluster0.xxxx.mongodb.net/loadmitra?retryWrites=true&w=majority
MONGODB_URI=mongodb://localhost:27017/loadmitra

# Secret used to sign JWTs. Use a long random string in production.
JWT_SECRET=dev-only-change-me

# Comma-separated allowed origins (shipper + captain web apps).
CORS_ORIGIN=http://localhost:8080,http://localhost:8081

# One-time-password lifetime (seconds).
OTP_TTL_SECONDS=300

# Number of reverse proxies in front of the API (1 behind the nginx in
# deploy/aws-ec2) so rate limits key on the real client IP. 0 = connect directly.
TRUST_PROXY=0

# Login code delivery: "screen" returns the code in the API response (local dev /
# labelled demo only; anyone can sign in as any number), "sms" needs an SMS adapter
# (not built yet → login returns 503). Default: screen outside production, sms in production.
# OTP_DELIVERY=screen

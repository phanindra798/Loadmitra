# Copy to .env and fill in. The API reads these at boot (validated with Zod).

# Server
PORT=4000
NODE_ENV=development

# MongoDB Atlas connection string (Database > Connect > Drivers).
# e.g. mongodb+srv://USER:PASS@cluster0.xxxx.mongodb.net/loadmitra?retryWrites=true&w=majority
MONGODB_URI=mongodb://localhost:27017/loadmitra

# Secret used to sign JWTs. Use a long random string in production.
JWT_SECRET=dev-only-change-me

# Comma-separated allowed origins (shipper + captain web apps).
CORS_ORIGIN=http://localhost:8080,http://localhost:8081

# One-time-password lifetime (seconds).
OTP_TTL_SECONDS=300
